{% set mingw = os.path.abspath(os.path.join(profile_dir, '../../build/windows/toolchains/mingw64')).replace('\\', '/') %}
[settings]
os=Windows
arch=x86_64
compiler=gcc
compiler.version=8
compiler.libcxx=libstdc++11
compiler.cppstd=17
build_type=Release

[conf]
tools.build:compiler_executables={"c": "{{ mingw }}/bin/gcc.exe", "cpp": "{{ mingw }}/bin/g++.exe"}
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:jobs=2
tools.build:cxxflags=["-Wa,-mbig-obj"]
